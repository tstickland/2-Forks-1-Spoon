# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
# Use your Hosting domain (e.g. my-project.web.app), not *.firebaseapp.com, so Google sign-in
# works inside the installed iPhone app (avoids Safari's cross-site storage blocking).
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to "true" to talk to local emulators (npm run emulators) instead of the real project.
VITE_USE_EMULATORS=false
